#
# cerro-torre.launcher.a2ml — per-app launcher config for Cerro Torre.
# Compliant with launcher-standard.a2ml v0.3.0

[project]
name         = "cerro-torre"
display      = "Cerro Torre"
description  = "Application"
categories   = ["Development"]
version      = "0.1.0"
license      = "MPL-2.0"

[repo]
path = ""

[runtime]
kind = "process"
startup-command-search = [
    "{repo-dir}/target/release/cerro-sign",
    "{repo-dir}/cerro-sign",
    "cerro-sign",
]
pid-file = "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/cerro-torre.pid"
log-file = "${XDG_STATE_HOME:-$HOME/.local/state}/cerro-torre/cerro-torre.log"
wait-for-url-timeout-seconds = 10

[version-output]
first-line-format = "cerro-torre {version} ({build-sha-short}) [{platform}]"
example = "cerro-torre 0.1.0 (abc1234) [linux-x86_64]"
exit-code = 0

[icon]
source = "{repo-dir}/assets/icon-256.png"
